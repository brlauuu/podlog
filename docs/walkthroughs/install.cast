{"version": 2, "width": 80, "height": 24, "timestamp": 1788719503, "env": {"SHELL": "/usr/bin/zsh", "TERM": "xterm-256color"}}
[0.019597, "o", "\r\n\u001b[1;36m# Fresh install of Podlog. Prerequisites: Docker with Compose v2, a HuggingFace token, and the pyannote licence accepted on HuggingFace.\u001b[0m\r\n"]
[2.521759, "o", "\u001b[1;32m$\u001b[0m docker compose version\r\n"]
[3.806925, "o", "Docker Compose version v5.1.1\r\n"]
[5.314968, "o", "\r\n\u001b[1;36m# 1. Clone, and switch to the newest released version.\u001b[0m\r\n"]
[7.816905, "o", "\u001b[1;32m$\u001b[0m git clone --quiet https://github.com/brlauuu/podlog.git /home/brlauuu/podlog-fresh\r\n"]
[12.056958, "o", "\u001b[1;32m$\u001b[0m git checkout --quiet v1.1.0\r\n"]
[14.784098, "o", "\u001b[1;32m$\u001b[0m cat VERSION\r\n"]
[15.987376, "o", "1.1.0\r\n"]
[17.489645, "o", "\r\n\u001b[1;36m# 2. Configure. Two required values: a Postgres password and your HuggingFace token.\u001b[0m\r\n"]
[19.991461, "o", "\u001b[1;32m$\u001b[0m cp .env.example .env\r\n"]
[22.82929, "o", "\u001b[1;32m$\u001b[0m sed -i \"s|^# POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=<strong password>|\" .env\r\n"]
[25.53513, "o", "\u001b[1;32m$\u001b[0m sed -i \"s|^# HF_TOKEN=.*|HF_TOKEN=hf_...|\" .env\r\n"]
[28.243314, "o", "\u001b[1;32m$\u001b[0m grep -E ^(POSTGRES_PASSWORD|HF_TOKEN)=<set>\r\n"]
[29.445807, "o", "POSTGRES_PASSWORD=<set>\r\nHF_TOKEN=<set>\r\n"]
[30.949127, "o", "\r\n\u001b[1;36m# (Recording only: this machine already runs a Podlog, so the ports move. A first install skips this.)\u001b[0m\r\n"]
[33.453395, "o", "\u001b[1;32m$\u001b[0m cat docker-compose.override.yml\r\n"]
[34.656377, "o", "services:\r\n  web:\r\n    ports: !override\r\n      - \"3001:3000\"\r\n  pipeline:\r\n    ports: !override\r\n      - \"127.0.0.1:8001:8000\"\r\n  db:\r\n    ports: !override\r\n      - \"127.0.0.1:5433:5432\"\r\n  ollama:\r\n    ports: !override\r\n      - \"127.0.0.1:11435:11434\"\r\n"]
[36.158408, "o", "\r\n\u001b[1;36m# 3. Start from the published images. No build.\u001b[0m\r\n"]
[38.660318, "o", "\u001b[1;32m$\u001b[0m make up-release\r\n"]
[39.86792, "o", "docker compose pull\r\n"]
[40.065449, "o", "\u001b[?25l\u001b[0G[+] pull 0/6\r\n"]
[40.065685, "o", " \u001b[33m⠋\u001b[0m Image ghcr.io/brlauuu/podlog-worker:stable                       Pulling \u001b[34m0.0s\u001b[0m\r\n \u001b[33m⠋\u001b[0m Image ghcr.io/brlauuu/podlog-web:stable                          Pulling \u001b[34m0.0s\u001b[0m\r\n \u001b[33m⠋\u001b[0m Image pgvector/pgvector@sha256:a947c45cdc5906a1bc951f20a8709e... Pulling \u001b[34m0.0s\u001b[0m\r\n \u001b[33m⠋\u001b[0m Image ollama/ollama@sha256:075246f72d4109385b4a01c3ac8e9cbd26... Pulling \u001b[34m0.0s\u001b[0m\r\n \u001b[33m⠋\u001b[0m Image ghcr.io/brlauuu/podlog-pipeline:stable                     Pulling \u001b[34m0.0s\u001b[0m\r\n \u001b[33m⠋\u001b[0m Image ghcr.io/brlauuu/podlog-backup:stable                       Pulling \u001b[34m0.0s\u001b[0m\r\n\u001b[?25h"]
