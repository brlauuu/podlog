[59.822384, "o", "\r\nPodlog is running.\r\n  This machine:  http://localhost:3000\r\n"]
[59.822686, "o", "  Same network:  http://192.168.1.190:3000\r\n\r\n  Anyone who can reach that address has full control of Podlog —\r\n  there is no login. They can add and delete feeds, delete episodes\r\n  and backups, and change settings. Keep it to networks you trust.\r\n  To turn LAN access off, bind web to 127.0.0.1:3000 in\r\n  docker-compose.override.yml (see the Security model in the guide).\r\n  The address is DHCP-assigned and can change on reboot; reserve it\r\n"]
[59.822786, "o", "  in your router if you want it stable.\r\n\r\n"]
[61.32611, "o", "\r\n\u001b[1;36m# 4. What is running, and where to open it.\u001b[0m\r\n"]
[63.828138, "o", "\u001b[1;32m$\u001b[0m docker compose ps --format table {{.Service}}\\t{{.Status}}\r\n"]
[65.305104, "o", "SERVICE    STATUS\r\nbackup     Up 17 seconds\r\ndb"]
[65.305427, "o", "         Up 22 seconds (healthy)\r\nollama     Up 22 seconds (healthy)\r\npipeline   Up 17 seconds (healthy)\r\nweb        Up 5 seconds\r\nworker     Up 5 seconds\r\n"]
[66.821984, "o", "\r\n\u001b[1;36m# The worker downloads about 3 GB of speech models on first boot. Health reports it as WARMING_UP until then.\u001b[0m\r\n"]
[69.324181, "o", "\u001b[1;32m$\u001b[0m curl -s http://localhost:8001/api/health\r\n"]
[70.561263, "o", "{\"status\":\"WARMING_UP\",\"services\":[{\"name\":\"Database\",\"status\":\"OK\",\"detail\":null},{\"name\":\"Worker\",\"status\":\"WARMING_UP\",\"detail\":null},{\"name\":\"Ollama\",\"status\":\"OK\",\"detail\":null},{\"name\":\"Pipeline API\",\"status\":\"OK\",\"detail\":null},{\"name\":\"Diarization\",\"status\":\"OK\",\"detail\":\"HuggingFace token valid, model licence accepted.\"}]}"]
[72.065832, "o", "\r\n\r\n\u001b[1;36m# 5. The local model Ask AI uses is a separate download. Just the default one here (1.9 GB):\u001b[0m\r\n"]
[74.568591, "o", "\u001b[1;32m$\u001b[0m docker compose exec ollama ollama pull qwen2.5:3b\r\n"]
[76.019911, "o", "\u001b]11;?\u001b\\\u001b[6n"]
[81.12762, "o", "\u001b[?2026h\u001b[?25l\u001b[1Gpulling manifest ⠋ \u001b[K\u001b[?25h\u001b[?2026l"]
[81.227953, "o", "\u001b[?2026h\u001b[?25l\u001b[1Gpulling manifest ⠙ \u001b[K\u001b[?25h\u001b[?2026l"]
[81.32717, "o", "\u001b[?2026h\u001b[?25l\u001b[1Gpulling manifest ⠹ \u001b[K\u001b[?25h\u001b[?2026l"]
[81.42753, "o", "\u001b[?2026h\u001b[?25l\u001b[1Gpulling manifest ⠸ \u001b[K\u001b[?25h\u001b[?2026l"]
[81.527882, "o", "\u001b[?2026h\u001b[?25l\u001b[1Gpulling manifest ⠼ \u001b[K\u001b[?25h\u001b[?2026l"]
[81.627176, "o", "\u001b[?2026h\u001b[?25l\u001b[1Gpulling manifest ⠴ \u001b[K\u001b[?25h\u001b[?2026l"]
[81.6717, "o", "\u001b[?2026h\u001b[?25l\u001b[1Gpulling manifest \u001b[K\r\npulling 5ee4f07cdb9b: 100% ▕██████████████████▏ 1.9 GB                         \u001b[K\r\npulling 66b9ea09bd5b: 100% ▕██████████████████▏   68 B                         \u001b[K\r\npulling eb4402837c78: 100% ▕██████████████████▏ 1.5 KB                         \u001b[K\r\npulling b5c0e5cf74cf: 100% ▕██████████████████▏ 7.4 KB                         \u001b[K\r\npulling 161ddde4c9cd: 100% ▕██████████████████▏  487 B                         \u001b[K\r\nverifying sha256 digest \u001b[K\r\nwriting manifest \u001b[K\r\nsuccess \u001b[K\u001b[?25h\u001b[?2026l\r\n"]
[83.184905, "o", "\r\n\u001b[1;36m# 6. Wait for the worker to finish warming up (the queue page shows a banner meanwhile).\u001b[0m\r\n"]
[85.687891, "o", "\u001b[1;33m… worker warming up\u001b[0m"]
[90.771598, "o", "."]
[95.825384, "o", "."]
