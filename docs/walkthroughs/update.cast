[66.017212, "o", "\r\n\u001b[1m==> Done\u001b[0m\r\n"]
[66.019457, "o", "Now on 1.1.0 (1db5e03).\r\n"]
[66.019482, "o", "Watch the migration land:  docker compose logs -f pipeline\r\n"]
[66.019508, "o", "If something is wrong:     make restore-db DATE=2026-09-06\r\n"]
[66.210684, "o", "\r\nPodlog is running.\r\n  This machine:  http://localhost:3000\r\n"]
[66.210939, "o", "  Same network:  http://192.168.1.190:3000\r\n\r\n  Anyone who can reach that address has full control of Podlog —\r\n  there is no login. They can add and delete feeds, delete episodes\r\n  and backups, and change settings. Keep it to networks you trust.\r\n  To turn LAN access off, bind web to 127.0.0.1:3000 in\r\n  docker-compose.override.yml (see the Security model in the guide).\r\n  The address is DHCP-assigned and can change on reboot; reserve it\r\n  in your router if you want it stable.\r\n\r\n"]
[67.720237, "o", "\r\n\u001b[1;36m# Now on 1.1.0. The migration ran on pipeline start:\u001b[0m\r\n"]
[70.221669, "o", "\u001b[1;32m$\u001b[0m docker compose logs --tail 8 pipeline\r\n"]
[71.495625, "o", "\u001b[36mpipeline-1  | \u001b[0mINFO:     Waiting for application startup.\r\n\u001b[36mpipeline-1  | \u001b[0mINFO:     Application startup complete.\r\n\u001b[36mpipeline-1  | \u001b[0mINFO:     Uvicorn running on http://0.0.0.0:8000 (Press CTRL+C to quit)\r\n\u001b[36mpipeline-1  | \u001b[0m{\"time\": \"2026-09-06 18:29:26,876\", \"level\": \"INFO\", \"logger\": \"app.services.telegram_bot\", \"message\": \"action\": \"telegram_bot_idle\", \"reason\": \"no bot token configured\"}\r\n"]
[71.495801, "o", "\u001b[36mpipeline-1  | \u001b[0m{\"time\": \"2026-09-06 18:29:30,655\", \"level\": \"INFO\", \"logger\": \"httpx\", \"message\": HTTP Request: GET http://ollama:11434/ \"HTTP/1.1 200 OK\"}\r\n\u001b[36mpipeline-1  | \u001b[0m{\"time\": \"2026-09-06 18:29:30,818\", \"level\": \"INFO\", \"logger\": \"httpx\", \"message\": HTTP Request: GET https://huggingface.co/api/whoami-v2 \"HTTP/1.1 200 OK\"}\r\n\u001b[36mpipeline-1  | \u001b[0m{\"time\": \"2026-09-06 18:29:30,934\", \"level\": \"INFO\", \"logger\": \"httpx\", \"message\": HTTP Request: GET https://huggingface.co/api/models/pyannote/speaker-diarization-community-1/auth-check \"HTTP/1.1 200 OK\"}\r\n\u001b[36mpipeline-1  | \u001b[0mINFO:     127.0.0.1:47002 - \"GET /api/health HTTP/1.1\" 200 OK\r\n"]
[73.002742, "o", "\u001b[1;32m$\u001b[0m curl -s http://localhost:8001/api/health\r\n"]
