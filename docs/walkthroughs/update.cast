{"version": 2, "width": 80, "height": 24, "timestamp": 1788719305, "env": {"SHELL": "/usr/bin/zsh", "TERM": "xterm-256color"}}
[0.013775, "o", "\r\n\u001b[1;36m# This install is on 1.0.1. Let's move it to the newest release.\u001b[0m\r\n"]
[2.515912, "o", "\u001b[1;32m$\u001b[0m git tag -l v* --sort=-v:refname\r\n"]
[3.721646, "o", "v1.1.0\r\nv1.0.1\r\nv1.0.0\r\nv0.7.0\r\nv0.6.0\r\nv0.5.7\r\nv0.5.6\r\nv0.5.5\r\n"]
[5.22533, "o", "\u001b[1;32m$\u001b[0m git status --short --branch\r\n"]
[6.438813, "o", "## \u001b[31mHEAD (no branch)\u001b[m\r\n"]
[7.942278, "o", "\r\n\u001b[1;36m# How do you learn an update exists? By default, nothing tells you: Podlog does not phone home. UPDATE_CHECK_ENABLED=true in .env adds a footer link.\u001b[0m\r\n"]
[10.444422, "o", "\u001b[1;32m$\u001b[0m grep -nE ^#? ?UPDATE_CHECK_ENABLED .env.example\r\n"]
[11.648748, "o", "172:# UPDATE_CHECK_ENABLED=false\r\n"]
[13.150878, "o", "\r\n\u001b[1;36m# make update does the whole thing: refuses on a dirty tree, drains the queue, takes a backup and refuses to continue without one, moves the working copy, pulls, reports config drift, restarts.\u001b[0m\r\n"]
[15.65305, "o", "\u001b[1;32m$\u001b[0m make update\r\n"]
[16.878026, "o", "\r\n\u001b[1m==> Checking the working copy\u001b[0m\r\n"]
[16.893289, "o", "clean\r\n"]
[16.898439, "o", "target: stable (newest release tag)\r\n\r\n\u001b[1m==> Draining the queue\u001b[0m\r\n"]
[17.234464, "o", "queue idle\r\n\r\n\u001b[1m==> Taking a database backup\u001b[0m\r\n"]
[18.386978, "o", "backup triggered; waiting for it to land...\r\n"]
[24.054324, "o", "dump for 2026-09-06 is on disk\r\n"]
[24.054493, "o", "\r\n\u001b[1m==> Moving the working copy\u001b[0m\r\n"]
