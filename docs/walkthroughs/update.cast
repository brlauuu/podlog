[75.73529, "o", "\r\n"]
[75.735448, "o", "\r\n\u001b[1;36m# If anything were wrong, the rollback is the two commands the update printed: restore the dump it took, then update to the version you were on.\u001b[0m\r\n"]
[78.237224, "o", "\r\n\u001b[1;36m# The browser recording shows the footer version and the release notes on /about.\u001b[0m\r\n"]
