FROM python:3.11-slim

RUN apt-get update && apt-get install -y \
    ffmpeg \
    libsndfile1 \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ARG INSTALL_DEV=false

COPY pyproject.toml poetry.lock* ./
# The worker runs every pipeline stage, so it installs the full ml group plus
# `embed` (#977) -- the latter holds sentence-transformers, which moved into
# its own group so the control plane can install it without whisperx,
# pyannote-audio and spacy. torch here comes from the CPU wheel index; see the
# pytorch-cpu source in pyproject.toml for why, and for the check that CPU and
# CUDA wheels embed identically.
#
# `--no-cache-dir` applies only to pip installing poetry itself. Poetry caches
# every dependency wheel in /root/.cache/pypoetry, which this same RUN layer
# then bakes into the image -- 8.0 GB of it (#939). Cleared at the end of the
# layer, not in a later one, or the bytes stay in the image.
RUN pip install --no-cache-dir poetry \
    && poetry config virtualenvs.create false \
    && if [ "$INSTALL_DEV" = "true" ]; then \
         poetry install --with ml,embed,dev --no-root --no-interaction --no-ansi; \
       else \
         poetry install --with ml,embed --without dev --no-root --no-interaction --no-ansi; \
       fi \
    && python -m spacy download en_core_web_trf \
    && python -m spacy download en_core_web_lg \
    && rm -rf /root/.cache/pypoetry

# Pre-download tiktoken encoder so the worker idle hook (#521) has no network dep
RUN python -c "import tiktoken; tiktoken.get_encoding('cl100k_base')"

COPY . .

ENV HF_HOME=/root/.cache/huggingface

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
